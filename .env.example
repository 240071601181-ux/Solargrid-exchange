# Frontend
# This workspace uses 8010 because 8000 is occupied on the delivery host.
# Keep these paths relative so the Vite dev/preview proxy can forward them to
# the API. That keeps the HttpOnly session cookie and readable CSRF cookie on
# the same origin; using localhost for the app and 127.0.0.1 for the API makes
# them cross-site and browsers will not send the SameSite=Lax CSRF cookie.
# For a separately hosted API, use an absolute URL and serve both over HTTPS
# with SESSION_COOKIE_SAMESITE=none (plus CORS_ORIGINS) or, preferably, put the
# API behind the same origin reverse proxy. The local proxy target is set in
# vite.config.ts (http://127.0.0.1:8010).
VITE_API_BASE_URL=/api/v1
VITE_WS_URL=/ws/simulation

# Backend
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/microgrid.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Location used for the MCP weather request
LATITUDE=10.976
LONGITUDE=76.914
LOCATION_NAME=Perur, Coimbatore, Tamil Nadu
TIMEZONE=Asia/Kolkata

# MCP weather server (local stdio server bundled in backend/mcp_weather_server.py)
WEATHER_MCP_ENABLED=true
WEATHER_CACHE_TTL_SECONDS=600
WEATHER_STALE_AFTER_SECONDS=1800
WEATHER_EXPIRE_AFTER_SECONDS=21600
WEATHER_FORECAST_HOURS=24

# Simulation and pricing defaults
SIMULATION_TICK_SECONDS=5
SIMULATION_INTERVAL_SECONDS=300
SIMULATION_SEED=20261026
AUTO_EXECUTE_TRADES=true
BASE_PRICE_INR_KWH=6.0
MIN_PRICE_INR_KWH=3.0
MAX_PRICE_INR_KWH=12.0
PRICE_SENSITIVITY=3.0
PRICE_SMOOTHING=0.65
MAX_TRADE_KW_PER_HOUSEHOLD=4.0
BATTERY_MAX_RATE_RATIO=0.5

# Authentication and sessions
# Local development runs over plain HTTP, so Secure=false is required for the
# browser to send the cookie. Set SESSION_COOKIE_SECURE=true behind HTTPS.
SESSION_COOKIE_NAME=sg_session
CSRF_COOKIE_NAME=sg_csrf
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
LOGIN_RATE_LIMIT_ATTEMPTS=8
LOGIN_RATE_LIMIT_WINDOW_SECONDS=600
REGISTRATION_RATE_LIMIT_ATTEMPTS=10
REGISTRATION_RATE_LIMIT_WINDOW_SECONDS=3600

# Optional first-start administrator bootstrap. Public registration can only
# create sellers and buyers; use these values or `python -m app.admin_cli`.
# Use a unique password of at least 10 characters with a letter and a number.
# BOOTSTRAP_ADMIN_EMAIL=operator@example.com
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_NAME=SolarGrid Operator
